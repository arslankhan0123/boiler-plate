APP_NAME=rapnex_retail_erp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rapnex_retail_erp
DB_USERNAME=root
DB_PASSWORD=12345

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Audit / activity logging (central, background).
AUDIT_ENABLED=true
# Queue connection for audit jobs. Local dev: `central_database` (pins jobs to
# the central DB so `database` driver works). Production: `redis` + run Horizon.
AUDIT_QUEUE_CONNECTION=central_database
AUDIT_QUEUE=audit
# Country-of-request geo. Drop a MaxMind GeoLite2-Country.mmdb at the path below
# (free MaxMind account/license) — resolution is null until then.
AUDIT_GEOIP_ENABLED=true
# AUDIT_GEOIP_DATABASE="${APP_BASE_PATH}/storage/app/geoip/GeoLite2-Country.mmdb"

# API docs (l5-swagger): rebuild the OpenAPI spec on every docs page load so
# new/changed endpoints appear immediately. Handy in local dev; keep false in
# production — regeneration adds latency to each request. Run
# `php artisan l5-swagger:generate` manually when this is false.
L5_SWAGGER_GENERATE_ALWAYS=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
